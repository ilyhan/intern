{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": [
      "DOM",
      "ES2017"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "typeRoots": ["node_modules/@types", "src/common/types"],
    "jsx": "react-jsx",
    "importHelpers": true
  },
  "include": ["src", "src/common/types", "config"],
  "exclude": [
    "node_modules"
  ]
}
